[Unit]
Description=Ensure Flashback chat Caddy routes survive park-tls rewrites
After=network.target caddy.service

[Service]
Type=oneshot
Environment=HOME=/root
Environment=XDG_CONFIG_HOME=/root/.config
# Park rewrites can truncate mid-write; give the file a moment to settle.
ExecStartPre=/bin/sleep 1
ExecStart=/opt/relay/chat/scripts/ensure-caddy-chat.sh
Nice=10
TimeoutStartSec=60
